---
import Reveal from './Reveal.astro';

const stats = [
  { value: 12, suffix: '', label: 'Live DECAL compliance checks on your dashboard' },
  { value: 4, suffix: '', label: 'Tailored surfaces — web portal + director, teacher & parent apps' },
  { value: 100, suffix: '%', label: 'Staff-reviewed before families see AI output' },
  { value: 2, suffix: '', label: 'Interface languages — English & Spanish UI' },
];
---

<section class="border-y border-caira-navy/10 bg-white">
  <div class="section-pad py-12 md:py-14">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        stats.map((stat, i) => (
          <Reveal delay={i * 0.05}>
            <div class="text-center">
              <p
                class="stat-counter-value"
                data-counter={stat.value}
                data-counter-suffix={stat.suffix}
              >
                0{stat.suffix}
              </p>
              <p class="mt-2 text-sm text-caira-navy/65">{stat.label}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
