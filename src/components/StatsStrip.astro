---
import SectionHeading from './SectionHeading.astro';
import Reveal from './Reveal.astro';

const stats = [
  { value: 90, suffix: '%', label: 'Less time on end-of-day logs' },
  { value: 3, suffix: 'x', label: 'More meaningful parent updates' },
  { value: 100, suffix: '%', label: 'Staff-reviewed before families see it' },
  { value: 2, suffix: '', label: 'Languages — English & Spanish' },
];
---

<section class="border-y border-caira-navy/10 bg-white">
  <div class="section-pad py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        stats.map((stat, i) => (
          <Reveal delay={i * 0.05}>
            <div class="text-center">
              <p
                class="stat-counter-value"
                data-counter={stat.value}
                data-counter-suffix={stat.suffix}
              >
                0{stat.suffix}
              </p>
              <p class="mt-2 text-sm text-caira-navy/65">{stat.label}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
