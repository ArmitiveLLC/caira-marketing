---
import DeviceFrame from './DeviceFrame.astro';
import type { Messages } from '../i18n';

interface Props {
  narrative: Messages['narrative'];
  storyImage?: string;
}

const { narrative, storyImage = '/screenshots/app-parent-daily-story.png' } = Astro.props;
---

<aside class="spotlight-dark narrative-quote relative overflow-hidden rounded-3xl px-8 py-10 md:px-12 md:py-14">
  <div class="pointer-events-none absolute -right-10 -top-10 h-48 w-48 rounded-full bg-caira-cyan/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-12 -left-8 h-40 w-40 rounded-full bg-caira-teal/25 blur-3xl" aria-hidden="true"></div>

  <div class="relative grid gap-10 lg:grid-cols-[1fr,auto] lg:items-center lg:gap-14">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-caira-cyan">{narrative.eyebrow}</p>
      <blockquote class="ai-sample mt-4 text-xl leading-relaxed text-white/95 md:text-2xl">
        "{narrative.quote}"
      </blockquote>
      <p class="mt-5 text-sm text-white/55">{narrative.caption}</p>
    </div>

    <div class="flex justify-center lg:justify-end">
      <DeviceFrame src={storyImage} alt={narrative.storyAlt} class="w-full max-w-[240px] shadow-glow-teal" />
    </div>
  </div>
</aside>
