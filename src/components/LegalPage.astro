---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import type { Locale } from '../i18n/config';
import { getMessages } from '../i18n';

interface Props {
  entryId: string;
  locale?: Locale;
}

const { entryId, locale = 'en' } = Astro.props;
const m = getMessages(locale);

const entry = await getEntry('legal', entryId);
if (!entry) throw new Error(`Legal content not found: ${entryId}`);
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} locale={locale}>
  <article class="section-pad prose prose-caira max-w-3xl">
    <p class="text-sm text-caira-navy/60">{m.legal.lastUpdated} {entry.data.lastUpdated}</p>
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
