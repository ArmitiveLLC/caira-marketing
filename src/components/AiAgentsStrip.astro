---
import SectionHeading from './SectionHeading.astro';
import Reveal from './Reveal.astro';
import type { Messages } from '../i18n';

interface Props {
  aiAgents: Messages['aiAgents'];
}

const { aiAgents } = Astro.props;
---

<section id="ai" class="scroll-mt-24 border-y border-caira-navy/10 bg-white">
  <div class="section-pad">
    <Reveal>
      <SectionHeading eyebrow={aiAgents.eyebrow} title={aiAgents.title} subtitle={aiAgents.subtitle} />
    </Reveal>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        aiAgents.agents.map((agent, i) => (
          <Reveal delay={i * 0.06}>
            <article class="ai-agent-card h-full">
              <p class="text-[10px] font-bold uppercase tracking-widest text-caira-teal">{agent.audience}</p>
              <h3 class="mt-2 text-lg font-bold text-caira-navy">{agent.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-caira-navy/75">{agent.body}</p>
            </article>
          </Reveal>
        ))
      }
    </div>

    <Reveal delay={0.2}>
      <div class="ai-assistants-panel mt-10 rounded-2xl border border-caira-navy/10 bg-caira-paper p-6 md:p-8">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-caira-teal">{aiAgents.assistantsHeading}</p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-3">
          {
            aiAgents.assistants.map((item) => (
              <li class="flex items-start gap-2 text-sm text-caira-navy/80">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-caira-cyan" aria-hidden="true"></span>
                {item}
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-sm leading-relaxed text-caira-navy/60">{aiAgents.footnote}</p>
      </div>
    </Reveal>
  </div>
</section>
