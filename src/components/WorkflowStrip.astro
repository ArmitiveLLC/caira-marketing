---
import Reveal from './Reveal.astro';
import type { Messages } from '../i18n';

interface Props {
  workflow: Messages['workflow'];
  steps: Array<Messages['workflow']['steps'][number] & { icon: string; color: string }>;
}

const { workflow, steps } = Astro.props;
---

<div class="workflow-strip glass-card relative overflow-hidden p-6 md:p-10">
  <div class="pointer-events-none absolute -left-20 top-0 h-40 w-40 rounded-full bg-caira-mint/40 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-16 bottom-0 h-48 w-48 rounded-full bg-caira-cyan/20 blur-3xl" aria-hidden="true"></div>

  <p class="relative text-center text-xs font-bold uppercase tracking-[0.2em] text-caira-teal">{workflow.eyebrow}</p>
  <p class="relative mt-2 text-center text-lg font-semibold text-caira-navy md:text-xl">{workflow.title}</p>

  <ol class="relative mt-10 grid gap-6 md:grid-cols-4 md:gap-4" data-reveal-stagger>
    {
      steps.map((step, i) => (
        <li class="workflow-step reveal relative flex flex-col items-center text-center" data-reveal data-reveal-delay={i * 0.08}>
          {i < steps.length - 1 && <span class="workflow-connector hidden md:block" aria-hidden="true" />}
          <span class:list={['flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br text-white shadow-lg', step.color]}>
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d={step.icon} />
            </svg>
          </span>
          <p class="mt-4 text-[10px] font-bold uppercase tracking-widest text-caira-teal">{step.label}</p>
          <h3 class="mt-1 text-sm font-bold text-caira-navy">{step.title}</h3>
          <p class="mt-2 text-xs leading-relaxed text-caira-navy/65">{step.detail}</p>
        </li>
      ))
    }
  </ol>
</div>
