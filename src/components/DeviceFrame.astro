---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  fetchpriority,
} = Astro.props;
---

<div class:list={['device-frame', className]}>
  <div class="device-frame-notch" aria-hidden="true"></div>
  <div class="device-screen">
    <img
      src={src}
      alt={alt}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class="w-full"
    />
  </div>
</div>
