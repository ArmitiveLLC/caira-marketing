---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from './SectionHeading.astro';
import HeroShowcase from './HeroShowcase.astro';
import BrowserFrame from './BrowserFrame.astro';
import DeviceFrame from './DeviceFrame.astro';
import WorkflowStrip from './WorkflowStrip.astro';
import NarrativeQuote from './NarrativeQuote.astro';
import SecurityTrust from './SecurityTrust.astro';
import Marquee from './Marquee.astro';
import StatsStrip from './StatsStrip.astro';
import RoleBlock from './RoleBlock.astro';
import Reveal from './Reveal.astro';
import SpotlightSection from './SpotlightSection.astro';
import FinalCTA from './FinalCTA.astro';
import AiAgentsStrip from './AiAgentsStrip.astro';
import ScreenshotShowcase from './ScreenshotShowcase.astro';
import type { Locale } from '../i18n/config';
import { getMessages } from '../i18n';
import { buildHomePageData, screenshots } from '../i18n/home-data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = getMessages(locale);
const data = buildHomePageData(m);
---

<BaseLayout title={m.meta.title} locale={locale}>
  <!-- Hero -->
  <section class="hero-mesh relative overflow-visible border-b border-caira-navy/5">
    <div class="pointer-events-none absolute -right-32 top-20 h-96 w-96 rounded-full bg-caira-cyan/15 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-24 bottom-10 h-72 w-72 rounded-full bg-caira-mint/30 blur-3xl" aria-hidden="true"></div>
    <div class="hero-pad">
      <div class="hero-grid grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
        <div>
          <p class="section-eyebrow mb-5">{m.hero.eyebrow}</p>
          <h1 class="text-4xl font-bold leading-[1.12] text-caira-navy md:text-5xl lg:text-[3.25rem] xl:text-[3.5rem]">
            {m.hero.titleBefore}<span class="text-gradient">{m.hero.titleGradient}</span>{m.hero.titleAfter}
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-caira-navy/75">{m.hero.body}</p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#pilot" class="btn-primary">
              {m.hero.ctaPilot}
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
            <a href="https://app.caira.care/sign-in" class="btn-secondary">{m.hero.ctaSignIn}</a>
          </div>
        </div>

        <Reveal direction="right" delay={0.1} class="flex justify-center lg:justify-end">
          <HeroShowcase slides={data.heroSlides} />
        </Reveal>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-2 lg:mt-10 lg:justify-start" data-reveal-stagger>
        {m.hero.trustPills.map((pill, i) => (
          <Reveal delay={i * 0.05} class="inline-block">
            <span class="stat-pill">{pill}</span>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <Marquee items={m.marqueeItems} />
  <StatsStrip stats={data.stats} />

  <!-- Workflow -->
  <section class="section-pad pt-10 pb-16 md:pt-12 md:pb-20">
    <WorkflowStrip workflow={m.workflow} steps={data.workflowSteps} />
  </section>

  <!-- Problem -->
  <SpotlightSection>
    <div class="section-pad py-14">
      <Reveal>
        <SectionHeading
          eyebrow={m.problem.eyebrow}
          title={m.problem.title}
          subtitle={m.problem.subtitle}
          light
        />
      </Reveal>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-reveal-stagger>
        {
          m.problem.items.map((item, i) => (
            <Reveal delay={i * 0.08}>
              <li class="glass-card-dark p-6 transition hover:bg-white/10">
                <p class="eyebrow-mono text-caira-cyan">{item.label}</p>
                <p class="mt-3 text-base leading-relaxed text-white/85">{item.text}</p>
              </li>
            </Reveal>
          ))
        }
      </ul>
    </div>
  </SpotlightSection>

  <!-- Roles -->
  <section id="roles" class="section-pad scroll-mt-24">
    <Reveal>
      <SectionHeading
        eyebrow={m.roles.eyebrow}
        title={m.roles.title}
        subtitle={m.roles.subtitle}
      />
    </Reveal>
    <div class="mt-16 space-y-20">
      {
        data.roleCards.map((card, i) => (
          <RoleBlock
            id={card.id}
            tag={card.tag}
            accent={card.accent}
            icon={card.icon}
            title={card.title}
            body={card.body}
            bullets={card.bullets}
            screenshot={card.screenshot}
            screenshotAlt={card.screenshotAlt}
            frame={card.frame}
            reverse={i % 2 === 1}
          />
        ))
      }
    </div>
  </section>

  <!-- Communications -->
  <section id="communications" class="scroll-mt-24 border-y border-caira-navy/10 bg-white">
    <div class="section-pad">
      <Reveal>
        <SectionHeading
          eyebrow={m.communications.eyebrow}
          title={m.communications.title}
          subtitle={m.communications.subtitle}
        />
      </Reveal>
      <div class="mt-14 grid items-stretch gap-10 md:grid-cols-3" data-reveal-stagger>
        {
          data.communicationsFeatures.map((f, i) => (
            <Reveal delay={i * 0.08} class="h-full">
              <div class="feature-showcase-col">
                <article class="feature-card bg-white/90">
                  <div class="feature-icon-wrap">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                      <path stroke-linecap="round" stroke-linejoin="round" d={f.icon} />
                    </svg>
                  </div>
                  <h3 class="text-lg font-bold text-caira-navy">{f.title}</h3>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-caira-navy/75">{f.body}</p>
                </article>
                <DeviceFrame
                  src={f.screenshot}
                  alt={f.screenshotAlt}
                  class="feature-showcase-device shadow-glass"
                />
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Classroom AI -->
  <section id="classroom" class="scroll-mt-24 bg-gradient-to-b from-caira-mint/25 to-caira-paper">
    <div class="section-pad">
      <Reveal>
        <SectionHeading
          eyebrow={m.classroom.eyebrow}
          title={m.classroom.title}
          subtitle={m.classroom.subtitle}
        />
      </Reveal>
      <div class="mt-14 grid items-stretch gap-10 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {
          data.classroomFeatures.map((f, i) => (
            <Reveal delay={i * 0.08} class="h-full">
              <div class="feature-showcase-col">
                <article class="feature-card bg-white/90">
                  <div class="feature-icon-wrap">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                      <path stroke-linecap="round" stroke-linejoin="round" d={f.icon} />
                    </svg>
                  </div>
                  <h3 class="text-lg font-bold text-caira-navy">{f.title}</h3>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-caira-navy/75">{f.body}</p>
                </article>
                <DeviceFrame
                  src={f.screenshot}
                  alt={f.screenshotAlt}
                  class="feature-showcase-device shadow-glass"
                />
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <AiAgentsStrip aiAgents={m.aiAgents} />

  <!-- Parent story spotlight -->
  <SpotlightSection>
    <div class="section-pad">
      <Reveal>
        <NarrativeQuote narrative={m.narrative} storyImage={screenshots.parentStory} />
      </Reveal>
    </div>
  </SpotlightSection>

  <!-- Compare -->
  <section class="section-pad border-y border-caira-navy/10 bg-white">
    <Reveal>
      <SectionHeading
        eyebrow={m.compare.eyebrow}
        title={m.compare.title}
        subtitle={m.compare.subtitle}
      />
    </Reveal>
    <div class="mx-auto mt-12 max-w-3xl overflow-hidden rounded-2xl border border-caira-navy/10 shadow-glass" data-reveal-stagger>
      <div class="grid grid-cols-2 bg-caira-navy/5 text-center text-xs font-bold uppercase tracking-widest text-caira-navy/50">
        <p class="border-r border-caira-navy/10 px-4 py-3">{m.compare.legacyHeader}</p>
        <p class="px-4 py-3 text-caira-teal">{m.compare.cairaHeader}</p>
      </div>
      {
        m.compare.rows.map((row, i) => (
          <Reveal delay={i * 0.06}>
            <div class="grid grid-cols-2 border-t border-caira-navy/10">
              <p class="border-r border-caira-navy/10 px-4 py-4 text-sm text-caira-navy/55">{row.legacy}</p>
              <p class="compare-row-highlight px-4 py-4 text-sm font-medium text-caira-navy">{row.caira}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </section>

  <!-- Operations -->
  <section id="features" class="section-pad scroll-mt-24">
    <Reveal>
      <SectionHeading
        eyebrow={m.operations.eyebrow}
        title={m.operations.title}
        subtitle={m.operations.subtitle}
      />
    </Reveal>
    <div class="mt-14 grid gap-8 lg:grid-cols-2">
      {
        data.operationsFeatures.map((f, i) => (
          <Reveal delay={i * 0.1}>
            <article class="bento-card">
              <div class="relative">
                <div class="feature-icon-wrap">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d={f.icon} />
                  </svg>
                </div>
                <p class="text-xs font-bold uppercase tracking-widest text-caira-teal">{f.subtitle}</p>
                <h3 class="mt-2 text-2xl font-bold text-caira-navy">{f.title}</h3>
                <p class="mt-4 max-w-md text-base leading-relaxed text-caira-navy/75">{f.body}</p>
              </div>
            </article>
          </Reveal>
        ))
      }
    </div>
    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <Reveal delay={0.1}>
        <BrowserFrame
          src={screenshots.lessonPlans}
          alt={m.operations.lessonPlansAlt}
          class="shadow-glass"
        />
      </Reveal>
      <Reveal delay={0.15}>
        <BrowserFrame
          src={screenshots.mealPlans}
          alt={m.operations.mealPlansAlt}
          class="shadow-glass"
        />
      </Reveal>
    </div>
    <Reveal delay={0.2}>
      <div class="mt-12">
        <ScreenshotShowcase
          src={screenshots.learningManager}
          alt={m.operations.learningManagerAlt}
          caption={m.operations.learningManagerCaption}
        />
      </div>
    </Reveal>
  </section>

  <!-- Sign-in & safety -->
  <section id="safety" class="scroll-mt-24 border-y border-caira-navy/10 bg-caira-paper">
    <div class="section-pad">
      <Reveal>
        <SectionHeading
          eyebrow={m.safety.eyebrow}
          title={m.safety.title}
          subtitle={m.safety.subtitle}
        />
      </Reveal>
      <div class="mt-14 grid gap-6 sm:grid-cols-2" data-reveal-stagger>
        {
          data.safetyFeatures.map((f, i) => (
            <Reveal delay={i * 0.06}>
              <article class="bento-card h-full">
                <div class="feature-icon-wrap">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d={f.icon} />
                  </svg>
                </div>
                <p class="text-xs font-bold uppercase tracking-widest text-caira-teal">{f.subtitle}</p>
                <h3 class="mt-2 text-xl font-bold text-caira-navy">{f.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-caira-navy/75">{f.body}</p>
              </article>
            </Reveal>
          ))
        }
      </div>
      <div class="mt-12 grid gap-8 lg:grid-cols-2">
        <Reveal delay={0.1}>
          <BrowserFrame
            src={screenshots.kiosk}
            alt={m.safety.kioskAlt}
            class="shadow-glass"
          />
        </Reveal>
        <Reveal delay={0.15}>
          <BrowserFrame
            src={screenshots.director}
            alt={m.safety.complianceAlt}
            class="shadow-glass"
          />
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Differentiators -->
  <section class="border-y border-caira-navy/10 bg-caira-paper">
    <div class="section-pad">
      <Reveal>
        <SectionHeading
          eyebrow={m.differentiators.eyebrow}
          title={m.differentiators.title}
          subtitle={m.differentiators.subtitle}
        />
      </Reveal>
      <div class="mt-14 grid gap-5 sm:grid-cols-2" data-reveal-stagger>
        {
          m.differentiators.items.map((d, i) => (
            <Reveal delay={i * 0.06}>
              <article class:list={['glass-card p-6', i % 2 === 0 ? 'bg-white/90' : 'bg-caira-mint/20']}>
                <h3 class="text-lg font-bold text-caira-navy">{d.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-caira-navy/75">{d.body}</p>
              </article>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <SecurityTrust security={m.security} infraItems={data.securityInfra} locale={locale} />

  <!-- How it works -->
  <section class="section-pad">
    <Reveal>
      <SectionHeading
        eyebrow={m.pilotProgram.eyebrow}
        title={m.pilotProgram.title}
        subtitle={m.pilotProgram.subtitle}
      />
    </Reveal>
    <ol class="relative mt-16 grid gap-10 md:grid-cols-3 md:gap-6" data-reveal-stagger>
      <div class="step-line" aria-hidden="true"></div>
      {
        data.pilotSteps.map((s, i) => (
          <li class="reveal relative text-center" data-reveal data-reveal-delay={i * 0.1}>
              <span class="relative z-10 mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-caira-teal to-caira-cyan text-sm font-bold text-white shadow-lg shadow-caira-teal/30">
                {s.step}
              </span>
              <h3 class="mt-5 text-lg font-bold text-caira-navy">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-caira-navy/70">{s.body}</p>
            </li>
        ))
      }
    </ol>
  </section>

  <FinalCTA pilot={m.pilot} pilotForm={m.pilotForm} />

  <!-- Contact -->
  <section id="contact" class="section-pad border-t border-caira-navy/10">
    <Reveal>
      <div class="mx-auto max-w-xl text-center">
        <SectionHeading title={m.contact.title} subtitle={m.contact.subtitle} />
        <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a href="mailto:support@caira.care" class="btn-primary">support@caira.care</a>
          <a href="https://app.caira.care/sign-in" class="btn-secondary">{m.hero.ctaSignIn}</a>
        </div>
      </div>
    </Reveal>
  </section>
</BaseLayout>
