---
import ArmitiveBadge from './ArmitiveBadge.astro';
import BrandLogo from './BrandLogo.astro';
import type { Locale } from '../i18n/config';
import { getMessages } from '../i18n';
import { localePath } from '../i18n/config';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'en';
const m = getMessages(locale);
const home = localePath(locale, '/');

const productLinks = [
  { href: `${home}#directors`, label: m.footer.productLinks.directors },
  { href: `${home}#teachers`, label: m.footer.productLinks.teachers },
  { href: `${home}#parents`, label: m.footer.productLinks.parents },
  { href: `${home}#communications`, label: m.footer.productLinks.communications },
  { href: `${home}#classroom`, label: m.footer.productLinks.features },
  { href: `${home}#ai`, label: m.footer.productLinks.aiSystem },
  { href: `${home}#safety`, label: m.footer.productLinks.signInSafety },
  { href: `${home}#security`, label: m.footer.productLinks.security },
];

const legalLinks = [
  { href: localePath(locale, '/privacy'), label: m.footer.legalLinks.privacy },
  { href: localePath(locale, '/support'), label: m.footer.legalLinks.support },
  { href: localePath(locale, '/terms'), label: m.footer.legalLinks.terms },
];
---

<footer class="border-t border-caira-navy/10 bg-white">
  <div class="section-pad pb-10 pt-12">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <BrandLogo />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-caira-navy/65">{m.footer.tagline}</p>
        {locale === 'en' && (
          <p class="mt-2 max-w-sm text-xs leading-relaxed text-caira-navy/50">{m.footer.sloganEs}</p>
        )}
        <div class="mt-6">
          <ArmitiveBadge />
        </div>
      </div>

      <div>
        <p class="eyebrow-mono mb-4">{m.footer.productHeading}</p>
        <nav class="flex flex-col gap-2" aria-label="Product links">
          {
            productLinks.map((link) => (
              <a href={link.href} class="text-sm text-caira-navy/70 transition hover:text-caira-teal">
                {link.label}
              </a>
            ))
          }
          <a
            href="https://app.caira.care"
            class="text-sm text-caira-navy/70 transition hover:text-caira-teal"
            target="_blank"
            rel="noopener noreferrer"
          >
            {m.footer.signInPortal}
          </a>
        </nav>
      </div>

      <div>
        <p class="eyebrow-mono mb-4">{m.footer.legalHeading}</p>
        <nav class="flex flex-col gap-2" aria-label="Legal links">
          {
            legalLinks.map((link) => (
              <a href={link.href} class="text-sm text-caira-navy/70 transition hover:text-caira-teal">
                {link.label}
              </a>
            ))
          }
          <a href="mailto:support@caira.care" class="text-sm text-caira-navy/70 transition hover:text-caira-teal">
            support@caira.care
          </a>
        </nav>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-caira-navy/10 pt-8 sm:flex-row">
      <p class="text-sm text-caira-navy/50">{m.footer.copyright.replace('{year}', String(new Date().getFullYear()))}</p>
      <p class="text-xs text-caira-navy/45">{m.footer.location}</p>
    </div>
  </div>
</footer>
