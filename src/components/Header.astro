---
import BrandLogo from './BrandLogo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Locale } from '../i18n/config';
import { getMessages } from '../i18n';
import { localePath } from '../i18n/config';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'en';
const m = getMessages(locale);
const home = localePath(locale, '/');

const roleLinks = [
  { href: `${home}#directors`, label: m.nav.directors, section: 'directors' },
  { href: `${home}#teachers`, label: m.nav.teachers, section: 'teachers' },
  { href: `${home}#parents`, label: m.nav.parents, section: 'parents' },
];

const productLinks = [
  { href: `${home}#classroom`, label: m.nav.classroomAI, section: 'classroom' },
  { href: `${home}#communications`, label: m.nav.communications, section: 'communications' },
  { href: `${home}#ai`, label: m.nav.aiSystem, section: 'ai' },
  { href: `${home}#safety`, label: m.nav.signInSafety, section: 'safety' },
];

const navLinks = [
  ...roleLinks,
  ...productLinks,
  { href: `${home}#security`, label: m.nav.security, section: 'security' },
];
---

<header
  data-site-header
  class="site-header sticky top-0 z-50 border-b border-transparent bg-caira-paper/75 backdrop-blur-lg transition duration-300"
>
  <div class="site-header-inner mx-auto max-w-site px-4 sm:px-6">
    <a href={home} class="site-header-logo flex shrink-0 items-center" aria-label="Caira home">
      <BrandLogo />
    </a>

    <nav class="site-header-nav hidden xl:flex" aria-label="Main">
      <ul class="site-nav-pill flex items-center gap-0.5 p-1">
        {
          roleLinks.map((link) => (
            <li>
              <a href={link.href} class="nav-link" data-nav-link data-section={link.section}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="nav-dropdown">
          <details class="nav-details group">
            <summary class="nav-link nav-link-summary">
              {m.nav.product}
              <svg class="nav-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <ul class="nav-dropdown-menu">
              {
                productLinks.map((link) => (
                  <li>
                    <a href={link.href} class="nav-link nav-link-dropdown" data-nav-link data-section={link.section}>
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
        <li>
          <a href={`${home}#security`} class="nav-link" data-nav-link data-section="security">
            {m.nav.security}
          </a>
        </li>
      </ul>
    </nav>

    <div class="site-header-actions flex shrink-0 items-center gap-2 sm:gap-3">
      <LanguageSwitcher locale={locale} />
      <a href="https://app.caira.care/sign-in" class="btn-ghost hidden whitespace-nowrap sm:inline-flex">
        {m.nav.signIn}
      </a>
      <a href={`${home}#pilot`} class="btn-primary hidden whitespace-nowrap px-4 py-2.5 text-xs sm:inline-flex sm:px-5 sm:text-sm">
        {m.nav.askPilot}
      </a>
      <button
        type="button"
        data-nav-toggle
        class="nav-toggle xl:hidden"
        aria-expanded="false"
        aria-controls="site-nav-menu"
        aria-label={m.nav.openMenu}
      >
        <svg class="nav-toggle-open h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg class="nav-toggle-close h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div data-nav-backdrop class="site-nav-backdrop xl:hidden" hidden></div>

  <nav id="site-nav-menu" data-nav-menu class="site-nav-drawer xl:hidden" aria-label="Mobile" hidden>
    <div class="site-nav-drawer-inner">
      {
        navLinks.map((link) => (
          <a href={link.href} class="nav-link nav-link-drawer" data-nav-link data-section={link.section}>
            {link.label}
          </a>
        ))
      }
      <div class="mt-4 flex flex-col gap-2 border-t border-caira-navy/10 pt-4">
        <LanguageSwitcher locale={locale} compact />
        <a href="https://app.caira.care/sign-in" class="btn-secondary w-full justify-center">{m.nav.signInPortal}</a>
        <a href={`${home}#pilot`} class="btn-primary w-full justify-center">{m.nav.askPilot}</a>
      </div>
    </div>
  </nav>
</header>
