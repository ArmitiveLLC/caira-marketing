---
import DeviceFrame from './DeviceFrame.astro';

interface Props {
  screenshot?: string;
  screenshotAlt?: string;
}

const { screenshot, screenshotAlt = 'Caira teacher app preview' } = Astro.props;
const hasScreenshot = Boolean(screenshot);
---

<div class="hero-preview relative" data-reveal style="animation-delay: 0.15s">
  <div class="hero-preview-glow" aria-hidden="true"></div>
  {
    hasScreenshot ? (
      <DeviceFrame src={screenshot!} alt={screenshotAlt} class="hero-float-card" />
    ) : (
      <div class="hero-preview-card">
        <div class="flex items-center justify-between border-b border-caira-navy/10 pb-3">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-caira-coral/80"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-caira-mint"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-caira-cyan"></span>
          </div>
          <span class="text-xs font-medium text-caira-navy/50">Toddler Room · Today</span>
        </div>
        <div class="mt-4 space-y-3">
          <div class="flex gap-3 rounded-xl bg-caira-mint/25 p-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-caira-teal text-white">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-caira-teal">Voice log</p>
              <p class="mt-0.5 text-sm text-caira-navy/80">"Emma built a tall block tower with a friend…"</p>
            </div>
          </div>
          <div class="rounded-xl border border-caira-cyan/30 bg-white p-4 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-caira-cyan">AI daily narrative</p>
            <p class="ai-sample mt-2 text-sm leading-relaxed text-caira-navy/90">
              Emma had a joyful morning in discovery center — she negotiated turns with blocks and named
              colors aloud, connecting to this week's GELDS math strand.
            </p>
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .hero-float-card {
    animation: hero-float 6s ease-in-out infinite;
  }
</style>
