---
interface Props {
  value: number;
  suffix?: string;
  prefix?: string;
  label: string;
  class?: string;
}

const { value, suffix = '', prefix = '', label, class: className = '' } = Astro.props;
---

<div class:list={['text-center', className]} data-reveal>
  <p
    class="stat-counter-value"
    data-counter={value}
    data-counter-suffix={suffix}
    data-counter-prefix={prefix}
  >
    {prefix}0{suffix}
  </p>
  <p class="mt-2 text-sm text-caira-navy/65">{label}</p>
</div>
