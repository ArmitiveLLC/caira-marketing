---
import { classroomBands, getPilotApiUrl, pilotContactEmail } from '../lib/pilot-api';

const apiUrl = getPilotApiUrl();
---

<div
  class="pilot-form-root mx-auto max-w-lg"
  data-pilot-form
  data-pilot-status="idle"
  data-api-url={apiUrl}
>
  <div class="pilot-form-success glass-card p-8 text-center" data-pilot-success>
    <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-caira-teal/15 text-caira-teal">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h3 class="text-xl font-bold text-caira-navy">Request received!</h3>
    <p class="mt-3 text-sm leading-relaxed text-caira-navy/70">
      Our team will reach out within one business day. You can also email us at{' '}
      <a href={`mailto:${pilotContactEmail}`} class="font-medium text-caira-teal hover:underline">
        {pilotContactEmail}
      </a>
    </p>
    <button type="button" class="btn-secondary mt-6" data-pilot-reset>Submit another inquiry</button>
  </div>

  <form class="pilot-form glass-card p-6 sm:p-8" data-pilot-fields novalidate>
    <div class="space-y-5">
      <div>
        <label class="pilot-label" for="pilot-name">Full name *</label>
        <input id="pilot-name" class="pilot-input" type="text" name="name" required autocomplete="name" />
      </div>
      <div>
        <label class="pilot-label" for="pilot-email">Work email *</label>
        <input id="pilot-email" class="pilot-input" type="email" name="email" required autocomplete="email" />
      </div>
      <div>
        <label class="pilot-label" for="pilot-center">Center name *</label>
        <input id="pilot-center" class="pilot-input" type="text" name="centerName" required autocomplete="organization" />
      </div>
      <div>
        <label class="pilot-label" for="pilot-location">Location</label>
        <input
          id="pilot-location"
          class="pilot-input"
          type="text"
          name="location"
          placeholder="City, state"
          autocomplete="address-level2"
        />
      </div>
      <div>
        <label class="pilot-label" for="pilot-classrooms">Number of classrooms</label>
        <select id="pilot-classrooms" class="pilot-input" name="classrooms">
          {classroomBands.map((band) => <option value={band}>{band}</option>)}
        </select>
      </div>
      <div>
        <label class="pilot-label" for="pilot-message">Tell us about your center</label>
        <textarea
          id="pilot-message"
          class="pilot-input min-h-[110px] resize-none"
          name="message"
          rows={4}
          placeholder="Frameworks you use, goals for the pilot, timeline…"
        ></textarea>
      </div>
      <p class="pilot-error text-sm text-red-600" data-pilot-error hidden></p>
      <button type="submit" class="btn-primary w-full justify-center" data-pilot-submit>
        <span data-pilot-submit-label>Ask about a pilot</span>
        <span class="pilot-submit-loading hidden items-center gap-2" data-pilot-loading aria-hidden="true">
          <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          Submitting…
        </span>
      </button>
      <p class="text-center text-xs text-caira-navy/50">
        Or email{' '}
        <a href={`mailto:${pilotContactEmail}?subject=Caira%20pilot%20inquiry`} class="text-caira-teal hover:underline">
          {pilotContactEmail}
        </a>{' '}
        directly.
      </p>
    </div>
  </form>
</div>

<script>
  import '../scripts/pilot-form.ts';
</script>
